// NVRTC stub for <limits>.
// Provides std::numeric_limits with explicit specializations using CUDA device
// intrinsics (__int_as_float, __longlong_as_double) for floating-point constants.
// Integer limits come from macros defined in nvrtc_stubs/limits.h.
#pragma once
#include <limits.h>

namespace std {

// Primary template — unspecialized types get sentinel "not-a-numeric-type" defaults.
template<typename T>
struct numeric_limits {
    static const bool is_specialized = false;
    static const bool is_integer     = false;
    static const bool is_signed      = false;
    static inline T min()      { return T(); }
    static inline T max()      { return T(); }
    static inline T lowest()   { return T(); }
    static inline T infinity() { return T(); }
    static inline T quiet_NaN(){ return T(); }
    static inline T epsilon()  { return T(); }
};

template<>
struct numeric_limits<float> {
    static const bool is_specialized = true;
    static const bool is_integer     = false;
    static const bool is_signed      = true;
    // IEEE 754 bit patterns decoded via CUDA intrinsic (device-safe):
    static inline float min()       { return __int_as_float(0x00800000); } // 1.175494e-38
    static inline float max()       { return __int_as_float(0x7f7fffff); } // 3.402823e+38
    static inline float lowest()    { return __int_as_float(0xff7fffff); } // -3.402823e+38
    static inline float infinity()  { return __int_as_float(0x7f800000); }
    static inline float quiet_NaN() { return __int_as_float(0x7fc00000); }
    static inline float epsilon()   { return __int_as_float(0x34000000); } // 1.192093e-07
};

template<>
struct numeric_limits<double> {
    static const bool is_specialized = true;
    static const bool is_integer     = false;
    static const bool is_signed      = true;
    static inline double min()       { return __longlong_as_double(0x0010000000000000LL); }
    static inline double max()       { return __longlong_as_double(0x7fefffffffffffffLL); }
    static inline double lowest()    { return __longlong_as_double(0xffefffffffffffffLL); }
    static inline double infinity()  { return __longlong_as_double(0x7ff0000000000000LL); }
    static inline double quiet_NaN() { return __longlong_as_double(0x7ff8000000000000LL); }
    static inline double epsilon()   { return __longlong_as_double(0x3cb0000000000000LL); }
};

